rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Collection: invites/{CODE}
    //   houseId: string, memberUids: string[]
    // Collection: houses/{houseId}
    //   id, name, inviteCode, rooms[], people[], rules{}, memberUids[]
    // Subcollection: houses/{houseId}/occurrences/{id}
    //
    // Join: GET invites/{CODE} → arrayUnion self on invite → arrayUnion
    // self on house. House join is allowed only if this uid is already
    // on the invite whose id equals the house inviteCode.

    function signedIn() {
      return request.auth != null;
    }

    function isHouseMember() {
      return signedIn() && request.auth.uid in resource.data.memberUids;
    }

    function validInviteCode(code) {
      return code is string
        && code.size() == 8
        && code.matches('^[A-Z0-9]+$');
    }

    function addingSelfOnly() {
      return request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['memberUids'])
        && request.auth.uid in request.resource.data.memberUids
        && !(request.auth.uid in resource.data.memberUids)
        && request.resource.data.memberUids.size()
          == resource.data.memberUids.size() + 1
        && request.resource.data.memberUids.size() <= 24
        && request.resource.data.memberUids.hasAll(resource.data.memberUids);
    }

    function memberUidsUnchanged() {
      return request.resource.data.memberUids.hasAll(resource.data.memberUids)
        && resource.data.memberUids.hasAll(request.resource.data.memberUids)
        && request.resource.data.memberUids.size()
          == resource.data.memberUids.size();
    }

    function inviteForHouse() {
      return exists(/databases/$(database)/documents/invites/$(resource.data.inviteCode))
        && get(/databases/$(database)/documents/invites/$(resource.data.inviteCode)).data.houseId
          == resource.data.id;
    }

    function joiningViaInvite() {
      return isValidHouse()
        && addingSelfOnly()
        && validInviteCode(resource.data.inviteCode)
        && inviteForHouse()
        && request.auth.uid in get(/databases/$(database)/documents/invites/$(resource.data.inviteCode)).data.memberUids;
    }

    function isValidInvite() {
      let d = request.resource.data;
      return d.keys().hasAll(['houseId', 'memberUids'])
        && d.houseId is string
        && d.houseId.size() > 0
        && d.houseId.size() < 80
        && d.memberUids is list
        && d.memberUids.size() >= 1
        && d.memberUids.size() <= 24;
    }

    function isValidHouse() {
      let d = request.resource.data;
      return d.id is string
        && d.id.size() > 0
        && d.id.size() < 80
        && d.name is string
        && d.name.size() > 0
        && d.name.size() <= 40
        && validInviteCode(d.inviteCode)
        && d.rooms is list
        && d.rooms.size() >= 1
        && d.rooms.size() <= 8
        && d.people is list
        && d.people.size() >= 1
        && d.people.size() <= 24
        && d.rules is map
        && d.memberUids is list
        && d.memberUids.size() >= 1
        && d.memberUids.size() <= 24;
    }

    function isValidHouseCreate(houseId) {
      return isValidHouse()
        && request.resource.data.memberUids.size() == 1
        && request.auth.uid in request.resource.data.memberUids
        && request.resource.data.id == houseId;
    }

    function isValidHouseMemberUpdate() {
      return isHouseMember()
        && isValidHouse()
        && request.resource.data.id == resource.data.id
        && request.resource.data.inviteCode == resource.data.inviteCode
        && memberUidsUnchanged()
        && request.auth.uid in request.resource.data.memberUids;
    }

    function validOccurrence() {
      let d = request.resource.data;
      return d.id is string
        && d.id.size() > 0
        && d.id.size() < 100
        && d.jobType is string
        && d.jobType.size() < 32
        && d.assignedRoom is int
        && d.assignedRoom >= 1
        && d.assignedRoom <= 20
        && d.completed is bool
        && d.notifiedOnTime is bool
        && (!('notes' in d) || (d.notes is string && d.notes.size() < 500));
    }

    match /invites/{code} {
      allow get: if signedIn() && validInviteCode(code);
      allow list: if false;
      allow create: if signedIn()
        && validInviteCode(code)
        && isValidInvite()
        && request.resource.data.memberUids.size() == 1
        && request.auth.uid in request.resource.data.memberUids;
      allow update: if signedIn() && isValidInvite() && addingSelfOnly();
      allow delete: if false;
    }

    match /houses/{houseId} {
      allow get: if isHouseMember();
      allow list: if false;
      allow create: if signedIn() && isValidHouseCreate(houseId);
      allow update: if signedIn() && (
        isValidHouseMemberUpdate() || joiningViaInvite()
      );
      allow delete: if false;

      match /occurrences/{id} {
        allow read: if signedIn()
          && request.auth.uid in get(/databases/$(database)/documents/houses/$(houseId)).data.memberUids;
        allow create, update: if signedIn()
          && request.auth.uid in get(/databases/$(database)/documents/houses/$(houseId)).data.memberUids
          && validOccurrence();
        allow delete: if false;
      }
    }
  }
}
